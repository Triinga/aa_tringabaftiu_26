function c2(A, key, lo, hi) {
    const D = new Array(hi - lo + 1).fill(0);
    for(let i =0; i< A.length; i++) D[key(A[i]) - lo]++; //count 
    for(let j = 1; j < D.length; j++) D[j] += D[j-1]; //sums
    const S = new Array(A.length);
    for(let i = A.length -1; i>=0; i--){
        const j = key(A[i]) - lo;
        S[D[j] - 1] = A[i];
        D[j]--;
    }
    return S; 
    
}
